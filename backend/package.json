{
  "name": "jeeplink-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "seed:demo": "node --env-file=.env scripts/seed-demo.js",
    "device:create": "node --env-file=.env scripts/create-device.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.2.1"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}

