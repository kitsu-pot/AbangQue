# Local example only: replace the password; do not commit .env.
DATABASE_URL=postgresql://jeeplink_app:CHANGE_ME@127.0.0.1:5432/jeeplink
HOST=127.0.0.1
PORT=3000
STALE_AFTER_SECONDS=120
MAX_UPDATE_AGE_SECONDS=86400
MAX_FUTURE_SKEW_SECONDS=30
DEVICE_RATE_LIMIT=120
# Demo rows are hidden from passenger reads unless explicitly enabled.
INCLUDE_DEMO=false


# Passenger sessions: opaque bearer token; absolute expiry in seconds (1 hour–30 days).
NODE_ENV=development
SESSION_TTL_SECONDS=604800
# Attempts per IP and per normalized login email in each 15-minute window.
AUTH_RATE_LIMIT=10
# Production HTTPS proxy on the same machine only; never trust arbitrary proxies.
TRUST_PROXY=false
