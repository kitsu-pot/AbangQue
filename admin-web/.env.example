# Server-side Vite development proxy; never place secrets in this file.
ADMIN_API_PROXY_TARGET=http://127.0.0.1:3000
# Empty uses same-origin /api/admin. Optional future HTTPS backend origin.
VITE_ADMIN_API_ORIGIN=

# Monitoring polling interval, 10–300 seconds. Defaults to 30; restart Vite after changes.
VITE_MONITORING_POLL_SECONDS=30
